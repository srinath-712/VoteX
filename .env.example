# VoteX Environment Variables Template
# Copy this file to .env and fill in the values

# Required: Get this from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Required for production: Set this to your live domain (e.g. https://votex.onrender.com)
# Defaults to http://localhost:5173 in development
CORS_ORIGIN=http://localhost:5173

# Optional: Port for the backend server
PORT=3001
